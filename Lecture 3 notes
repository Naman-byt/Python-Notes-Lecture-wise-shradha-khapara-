# Q2: Write a program to check if a list contains a palindrome of elements.
# (Hint: Use copy() method)
# Concept: A palindrome reads the same backwards and forwards (e.g., [1, 2, 3, 2, 1] or ["m", "a", "m"])

list_to_check = [1, 2, 3, 2, 1]

# Step 1: Make a copy of the list
list_copy = list_to_check.copy()

# Step 2: Reverse the copied list
list_copy.reverse()

# Step 3: Compare original list with reversed copy
if list_copy == list_to_check:
    print("Result: The list is a Palindrome")
else:
    print("Result: The list is NOT a Palindrome")


